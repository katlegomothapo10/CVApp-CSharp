@model CVViewModel

@{
    ViewData["Title"] = "Katlego Mothapo - CV";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .cv-container {
            max-width: 1200px;
            margin: 30px auto;
            background-color: white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .cv-header {
            background-color: #2c3e50;
            color: white;
            padding: 30px;
            text-align: center;
        }

            .cv-header h1 {
                font-size: 2.5rem;
                margin-bottom: 5px;
                font-weight: 600;
                margin-top: 0;
            }

            .cv-header h3 {
                font-size: 1.2rem;
                font-weight: 300;
                color: #ecf0f1;
                margin-bottom: 0;
            }

        .contact-bar {
            background-color: #34495e;
            color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .contact-item i {
                width: 20px;
                color: #3498db;
            }

        .cv-main {
            display: flex;
            flex-wrap: wrap;
        }

        .cv-sidebar {
            width: 33.333%;
            background-color: #f8f9fa;
            padding: 25px;
            border-right: 1px solid #dee2e6;
            box-sizing: border-box;
        }

        .cv-content {
            width: 66.666%;
            padding: 25px;
            box-sizing: border-box;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #3498db;
            color: #2c3e50;
        }

        .profile-text {
            margin-bottom: 25px;
            font-size: 0.95rem;
        }

        .education-item {
            margin-bottom: 20px;
        }

            .education-item h4 {
                font-size: 1.1rem;
                font-weight: 600;
                margin-bottom: 5px;
                margin-top: 0;
            }

            .education-item .institution {
                font-weight: 500;
                color: #3498db;
            }

            .education-item .years {
                color: #6c757d;
                font-size: 0.9rem;
                margin-bottom: 5px;
            }

        .language-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            padding-bottom: 5px;
            border-bottom: 1px dashed #dee2e6;
        }

        .language-name {
            font-weight: 500;
        }

        .language-level {
            color: #3498db;
        }

        .skill-category {
            margin-bottom: 20px;
        }

            .skill-category h5 {
                font-size: 1rem;
                font-weight: 600;
                color: #2c3e50;
                margin-bottom: 10px;
                margin-top: 0;
            }

        .skill-items {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .skill-tag {
            background-color: #e9ecef;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            color: #495057;
        }

        .experience-item {
            margin-bottom: 25px;
        }

        .experience-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            margin-bottom: 5px;
        }

            .experience-header h4 {
                font-size: 1.1rem;
                font-weight: 600;
                margin: 0;
            }

        .experience-company {
            color: #3498db;
            font-weight: 500;
        }

        .experience-year {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .responsibilities {
            list-style-type: none;
            padding-left: 0;
            margin-top: 10px;
            margin-bottom: 10px;
        }

            .responsibilities li {
                margin-bottom: 8px;
                padding-left: 20px;
                position: relative;
                font-size: 0.95rem;
            }

                .responsibilities li:before {
                    content: "•";
                    color: #3498db;
                    font-weight: bold;
                    position: absolute;
                    left: 0;
                }

        .achievement {
            background-color: #e8f4f8;
            padding: 8px 12px;
            border-radius: 5px;
            margin-top: 10px;
            font-size: 0.9rem;
            border-left: 3px solid #3498db;
        }

        .project-item {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 15px;
        }

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 5px;
        }

            .project-header h5 {
                font-size: 1rem;
                font-weight: 600;
                margin: 0;
            }

        .project-year {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .project-description {
            font-size: 0.95rem;
            margin: 10px 0;
        }

        .certification-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e9ecef;
        }

        .cert-name {
            font-weight: 500;
        }

        .cert-provider {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .cert-date {
            color: #3498db;
            font-size: 0.9rem;
        }

        .social-links {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 15px;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #3498db;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .social-link:hover {
                text-decoration: underline;
            }

        .action-buttons {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1000;
        }

        .btn-custom {
            background-color: #2c3e50;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            margin: 5px;
            cursor: pointer;
            display: inline-block;
            text-decoration: none;
        }

            .btn-custom:hover {
                background-color: #34495e;
                color: white;
            }

        @@media (max-width: 768px) {
            .cv-sidebar, .cv-content {
                width: 100%;
                border-right: none;
            }

            .contact-bar {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="action-buttons">
        <a href="@Url.Action("Print")" class="btn-custom" target="_blank">
            <i class="fas fa-print"></i> Print
        </a>
    </div>

    <div class="cv-container">
        <div class="cv-header">
            <h1>@Model.PersonalInfo.FullName</h1>
            <h3>@Model.PersonalInfo.Title</h3>
        </div>

        <div class="contact-bar">
            <div class="contact-item">
                <i class="fas fa-envelope"></i>
                <span>@Model.PersonalInfo.Email</span>
            </div>
            <div class="contact-item">
                <i class="fas fa-phone"></i>
                <span>@Model.PersonalInfo.Phone</span>
            </div>
        </div>

        <div class="cv-main">
            <div class="cv-sidebar">
                <div class="profile-text">
                    <div class="section-title">Profile</div>
                    <p>@Model.PersonalInfo.Profile</p>
                </div>

                <div class="education-section">
                    <div class="section-title">Education</div>
                    @foreach (var edu in Model.Education)
                    {
                        <div class="education-item">
                            <h4>@edu.Qualification</h4>
                            <div class="institution">@edu.Institution</div>
                            <div class="years">@edu.Years</div>
                        </div>
                    }
                </div>

                <div class="languages-section">
                    <div class="section-title">Languages</div>
                    @foreach (var lang in Model.Languages)
                    {
                        <div class="language-item">
                            <span class="language-name">@lang.Name</span>
                            <span class="language-level">@lang.Proficiency</span>
                        </div>
                    }
                </div>

                <div class="skills-section">
                    <div class="section-title">Skills</div>
                    @foreach (var skillCat in Model.Skills)
                    {
                        <div class="skill-category">
                            <h5>@skillCat.Category</h5>
                            <div class="skill-items">
                                @foreach (var skill in skillCat.Items)
                                {
                                    <span class="skill-tag">@skill</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="certifications-section">
                    <div class="section-title">Certifications (In Progress)</div>
                    @foreach (var cert in Model.Certifications)
                    {
                        <div class="certification-item">
                            <div>
                                <div class="cert-name">@cert.Name</div>
                                <div class="cert-provider">@cert.Provider</div>
                            </div>
                            <div class="cert-date">@cert.ExpectedDate</div>
                        </div>
                    }
                </div>
            </div>

            <div class="cv-content">
                <div class="experience-section">
                    <div class="section-title">Work Experience</div>

                    @foreach (var exp in Model.WorkExperiences)
                    {
                        <div class="experience-item">
                            <div class="experience-header">
                                <h4>@exp.Position</h4>
                                <span class="experience-year">@exp.Year</span>
                            </div>
                            <div class="experience-company">@exp.Company</div>

                            <ul class="responsibilities">
                                @foreach (var resp in exp.Responsibilities)
                                {
                                    <li>@resp</li>
                                }
                            </ul>

                            @if (!string.IsNullOrEmpty(exp.Achievement))
                            {
                                <div class="achievement">
                                    <i class="fas fa-trophy" style="margin-right: 8px;"></i>
                                    @exp.Achievement
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="projects-section">
                    <div class="section-title">Projects</div>

                    @foreach (var project in Model.Projects)
                    {
                        <div class="project-item">
                            <div class="project-header">
                                <h5>@project.Name</h5>
                                <span class="project-year">@project.Year</span>
                            </div>
                            <div class="project-description">@project.Description</div>
                            @if (!string.IsNullOrEmpty(project.Achievement))
                            {
                                <div class="achievement">
                                    <i class="fas fa-star" style="margin-right: 8px;"></i>
                                    @project.Achievement
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="links-section">
                    <div class="section-title">Links</div>
                    <div class="social-links">
                        @foreach (var link in Model.SocialLinks)
                        {
                            <a href="https://@link.Url" target="_blank" class="social-link">
                                @if (link.Platform == "LinkedIn")
                                {
                                    <i class="fab fa-linkedin"></i>
                                }
                                else if (link.Platform == "GitHub")
                                {
                                    <i class="fab fa-github"></i>
                                }
                                else if (link.Platform.Contains("TikTok") || link.Platform.Contains("OurGoatedLunchbox") || link.Platform.Contains("Personal Branding"))
                                {
                                    <i class="fab fa-tiktok"></i>
                                }
                                else
                                {
                                    <i class="fas fa-link"></i>
                                }
                                @link.Platform
                            </a>
                        }
                    </div>

                    <div style="margin-top: 15px;">
                        <a href="@Model.PersonalInfo.PortfolioUrl" target="_blank" class="social-link">
                            <i class="fas fa-folder"></i> Portfolio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>